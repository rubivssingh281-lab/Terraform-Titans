# =========================================================================
# Echolytix Environment Variables Configuration Template
# =========================================================================

# ----------------- BACKEND SETTINGS (Render) -----------------------------
# PORT: The port the Express backend binds to. Defaults to 3000.
# Render automatically supplies the PORT environment variable at runtime.
PORT=3000

# NODE_ENV: Set to 'production' when deployed.
NODE_ENV=production

# DATABASE_PATH: Optional. Absolute path to the SQLite database file.
# Point this at a mounted persistent disk (e.g. /data/echolytix.db) so user
# accounts survive deploys/restarts. Defaults to ./echolytix.db in the app dir.
# DATABASE_PATH=/data/echolytix.db

# FRONTEND_URL: The absolute HTTPS URL of your Netlify frontend deployment.
# Used by CORS to restrict credentialed cross-origin requests to your Netlify app.
FRONTEND_URL="https://aquamarine-chaja-ae233c.netlify.app"

# API_KEY or GEMINI_API_KEY: Optional. Used for Gemini smart phrase completion.
# If not provided, Echolytix falls back to local transition-matrix completion.
GEMINI_API_KEY="your_gemini_api_key_here"
API_KEY="your_gemini_api_key_here"

# ----------------- FRONTEND SETTINGS (Netlify) ---------------------------
# VITE_API_URL: The secure absolute HTTPS URL of your Render backend.
# Crucial at build time for client API call routing and redirects.
VITE_API_URL="https://echolytix.onrender.com"
