# =========================================================================
# Echolytix Environment Variables Configuration Template
# =========================================================================

# ----------------- LOCAL DEVELOPMENT PRESET -----------------------------
# PORT: The port the Express backend + Vite client binds to. Defaults to 3000.
PORT=3000

# NODE_ENV: Set to 'development' for hot-reload dev mode, or 'production' for live static builds.
NODE_ENV=development

# DATABASE_PATH: Path to SQLite database file.
# Defaults to ./echolytix.db in the application root.
DATABASE_PATH=./echolytix.db

# GEMINI_API_KEY / API_KEY: Optional Gemini API key for smart phrase completions.
# If omitted, Echolytix automatically falls back to built-in offline ML Markov transitions.
GEMINI_API_KEY=""
API_KEY=""

# VITE_API_URL: Leave empty for unified local development (same-origin routing).
VITE_API_URL=""

# ----------------- CLOUD / PRODUCTION SETTINGS (Render + Netlify) -------
# When separating frontend (Netlify) and backend (Render):
# FRONTEND_URL="https://aquamarine-chaja-ae233c.netlify.app"
# VITE_API_URL="https://echolytix.onrender.com"

